# Copy this file to .env and fill in real values. .env is gitignored.

# Google Maps API key restricted to this app's iOS bundle ID (com.anonymous.SilzentZone)
GOOGLE_MAPS_IOS_API_KEY=

# Google Maps API key restricted to this app's Android package (com.anonymous.SilzentZone) + SHA-1
GOOGLE_MAPS_ANDROID_API_KEY=
